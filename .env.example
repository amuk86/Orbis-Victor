# Browser configuration: public Firebase web-app identifiers, NOT Admin credentials.
# Leave empty to use only /game/demo; /play explains missing cloud setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false
# Local emulators only; use the same demo- project ID on client/server.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Server-only variables. Configure privately in .env.local or Vercel settings.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private PEM key; quoted value can use literal \n. Never prefix this NEXT_PUBLIC_.
FIREBASE_PRIVATE_KEY=
FIREBASE_USE_EMULATORS=false
# Set these ONLY when using emulators; remove completely in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/untracked/service-account.json
