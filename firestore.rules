rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function visible(id) {
      return exists(/databases/$(database)/documents/campaigns/$(id))
        && get(/databases/$(database)/documents/campaigns/$(id)).data.status == 'ready';
    }
    match /campaigns/{id} {
      allow get: if resource.data.status == 'ready';
      // Owner queries must filter ownerId, status=ready and use a bounded limit.
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'ready' && request.query.limit <= 30;
      // Even owners cannot write authoritative state or dice directly.
      allow create, update, delete: if false;
      match /history/{page} {
        allow get: if visible(id);
        allow list: if visible(id) && request.query.limit <= 20;
        allow write: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
